# Query for mail ../../mails/2026-03-20_ac_meetings_mail_to_Hannah_Marc_Min.txt
PREFIX or: <http://openreview.net/>
PREFIX person: <https://openreview.net/profile?id=~>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?pc_chair ?firstname ?table WHERE {
  VALUES ?pc_chair { person:Hannah_Bast1 person:Marc_Najork1 person:Min_Zhang15 }
  ?pc_chair or:firstname_or_fullname ?firstname .
  { SELECT (GROUP_CONCAT(?row; SEPARATOR="\n") AS ?rows) WHERE {
    { SELECT ?ac (COUNT(?submission) AS ?num_submissions) (COUNT(?decision) AS ?num_decisions) (SUM(IF(BOUND(?decision) && ?decision = "Accept",1,0)) AS ?accept) (SUM(IF(BOUND(?decision) && STRSTARTS(?decision, "Discuss"),1,0)) AS ?discuss) WHERE {
      ?ac or:role or:AC . MINUS { VALUES ?ac { person:Hannah_Bast2 person:Marc_Najork2 person:Min_Zhang32 } }
	  ?submission or:assigned ?ac; or:status "submitted" .
	  OPTIONAL { ?submission or:has_decision [ or:decision ?decision ] . }
    } GROUP BY ?ac }
    ?ac rdfs:label ?fullname; or:uuid ?uuid .
    BIND (CONCAT("| [", ?fullname, "](", STR(?ac), ") | ", STR(?num_submissions), " | ",  STR(?num_decisions), " | ", STR(?accept), " | ", STR(?discuss), " | [", ?uuid, "](https://qlever.dev/ac-meetings/?id=", ?uuid, ") |") AS ?row) 
  }	}
  BIND (CONCAT("| AC | Submissions | Decisions | Accept | Discuss | Link to webpage with table |", "\n",
               "|:-- |:----------- |:--------- |:------ |:------- |:-------------------------- |", "\n", ?rows) AS ?table)
}
