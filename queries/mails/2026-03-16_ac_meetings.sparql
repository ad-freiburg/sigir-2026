# Query for mail ../../mails/2026-03-16_ac_meetings.txt
PREFIX or: <http://openreview.net/>
PREFIX person: <https://openreview.net/profile?id=~>
PREFIX pangram: <https://pangram.com/rdf/schema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?ac ?firstname_or_fullname ?count ?table WHERE {
  { SELECT ?ac (GROUP_CONCAT(?row; SEPARATOR="\n") AS ?rows) (COUNT(?row) AS ?count) WHERE {
    SELECT ?ac ?number ?row WHERE {
	  ?submission a or:Submission; or:status "submitted"; or:number ?number; or:title ?title .
	  ?ac or:role or:AC; ^or:assigned ?submission . MINUS { VALUES ?ac { person:Hannah_Bast2 person:Marc_Najork2 person:Min_Zhang32 } }
	  OPTIONAL { ?spc or:role or:SPC; ^or:assigned ?submission; rdfs:label ?spc_name; or:email ?spc_email . MINUS { VALUES ?spc { person:Hannah_Bast2 person:Marc_Najork2 person:Min_Zhang32 } } }
	  BIND (IF(STRLEN(?title) > 30, CONCAT(SUBSTR(?title, 1, 27), "..."), ?title) AS ?title_abbrv) 
      OPTIONAL { SELECT ?submission (GROUP_CONCAT(CONCAT(STR(?score),IF(?fraction_ai = 1.0, CONCAT("[!](",STR(?review),")"), "")); SEPARATOR=", ") AS ?scores) WHERE { SELECT ?submission ?pc ?review ?score ?fraction_ai ?link_ai WHERE { ?submission or:has_review ?review . ?review or:reviewer ?pc; or:rating ?score; pangram:fraction_ai ?fraction_ai; pangram:dashboard_link ?link_ai . ?pc or:role or:PC } INTERNAL SORT BY ?submission ?pc } GROUP BY ?submission }
      OPTIONAL { SELECT ?submission (GROUP_CONCAT(STR(?conf); SEPARATOR=", ") AS ?confs) WHERE { SELECT ?submission ?pc ?conf WHERE { ?submission or:has_review ?review . ?review or:reviewer ?pc; or:confidence ?conf . ?pc or:role or:PC } INTERNAL SORT BY ?submission ?pc } GROUP BY ?submission }
	  OPTIONAL { SELECT ?submission (GROUP_CONCAT(COALESCE(STR(?rating),"-"); SEPARATOR=", ") AS ?ratings) WHERE { SELECT ?submission ?pc ?rating WHERE { ?submission or:has_review ?review. ?review or:reviewer ?pc . OPTIONAL { ?review or:rating_value ?rating } ?pc or:role or:PC } INTERNAL SORT BY ?submission ?pc } GROUP BY ?submission }
      OPTIONAL { SELECT ?submission (CONCAT("len = ", STR(SUM(STRLEN(?text)))) AS ?reviews) WHERE { ?submission or:has_review ?review . ?review pangram:text ?text } GROUP BY ?submission }
      OPTIONAL { SELECT ?submission (CONCAT("n = ", STR(COUNT(?comment)), ", len = ", STR(SUM(STRLEN(?text)))) AS ?comments) WHERE { ?submission or:has_comment ?comment . ?comment or:text ?text } GROUP BY ?submission }
      OPTIONAL { SELECT ?submission (CONCAT(IF(SAMPLE(?rec) = "accept", "A" , IF(SAMPLE(?rec) = "reject", "R", "U")), IF(SAMPLE(?fraction_ai) = 1.0, CONCAT("[!](",STR(SAMPLE(?metareview)),")"), ""), ", len = ", STR(SUM(STRLEN(?text)))) AS ?metareviews) WHERE { ?submission or:has_metareview ?metareview . ?metareview or:text ?text; or:recommendation ?rec; pangram:fraction_ai ?fraction_ai; pangram:dashboard_link ?link_ai } GROUP BY ?submission }
	  BIND(CONCAT("[", ?spc_name, "](mailto:", ?spc_email, ")") AS ?spc_contact)
      BIND (CONCAT("| ", STR(?number), " | [", ?title_abbrv, "](", STR(?submission), ") | ", ?scores, " | ", ?confs, " | ", ?ratings, " | ", COALESCE(?comments, "none"), " | ", COALESCE(?metareviews, "none"), " | ", COALESCE(?spc_contact, "none")) AS ?row)
	} INTERNAL SORT BY ?ac ?number
  } GROUP BY ?ac }
  BIND (CONCAT("| Number | Title | Review Scores | Confidences | SPC Ratings | Official Comments | Metareview | SPC |", "\n", "|:----- |:----- |:------- |:------- |:------- |:-------- |:--------- |:--- |", "\n", ?rows) AS ?table)
  ?ac or:firstname_or_fullname ?firstname_or_fullname .
}
ORDER BY ?ac
