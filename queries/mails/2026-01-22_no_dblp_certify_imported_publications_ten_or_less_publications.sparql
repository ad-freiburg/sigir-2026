# Query for mail ../../mails/2026-01-22_no_dblp_certify_imported_publications_ten_or_less_publications.txt
PREFIX or: <http://openreview.net/>
PREFIX dblp: <https://dblp.org/rdf/schema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?author ?author_name ?position ?imported_pubs WHERE {
  { SELECT DISTINCT ?author WHERE { ?submission or:status "submitted" . ?submission or:author ?author } }
  ?author or:dblp_id or:novalue .
  ?author rdfs:label ?author_name .
  ?author or:position ?position .
  MINUS { ?author or:role [] } 
  FILTER (?author_name != or:novalue)
  OPTIONAL { ?author or:num_publications ?imported_pubs }  
  MINUS { ?author or:task_dblp_status [] }
  FILTER (?imported_pubs != 1 && ?imported_pubs <= 10)
}
ORDER BY DESC(?imported_pubs)
