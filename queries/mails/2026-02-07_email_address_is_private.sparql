# Query for mail ../../mails/2026-02-07_email_address_is_private.txt
PREFIX or: <http://openreview.net/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?person ?firstname_or_fullname ?email WHERE {
  ?person or:email ?email .
  ?person or:firstname_or_fullname ?firstname_or_fullname .
  ?submission or:author ?person .
  ?submission or:status "submitted" .
  FILTER STRSTARTS(?email, "****")
}
