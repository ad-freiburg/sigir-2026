# Number of reviews over time (cumulative)
#defaultView:BarChart
PREFIX or: <http://openreview.net/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (STR(?day) AS ?date) ?num_reviews WHERE {
  {
    SELECT ?day (SUM(?cdate <= ?day) AS ?num_reviews) WHERE {
      {
        SELECT DISTINCT ?day WHERE {
          { ?r rdf:type or:Review ; or:cdate ?day . }
          UNION { VALUES ?day { "2026-01-19"^^xsd:date "2026-03-05"^^xsd:date } }
          FILTER(?day >= "2026-01-19"^^xsd:date && ?day <= "2026-03-05"^^xsd:date)
        }
      }
      ?review rdf:type or:Review ; or:cdate ?cdate .
    } GROUP BY ?day
  }
}
ORDER BY ?day
