# No DBLP + did not fill out form, grouped by submission
PREFIX or: <http://openreview.net/>
PREFIX dblp: <https://dblp.org/rdf/schema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?submission ?num_authors (COUNT(DISTINCT ?author) AS ?num_problematic) (GROUP_CONCAT(DISTINCT ?author_name; SEPARATOR=" | ") AS ?problematic_authors) WHERE {
  { SELECT DISTINCT ?author WHERE { ?submission or:status "submitted" . ?submission or:author ?author } }
  ?author or:dblp_id or:novalue .
  ?author rdfs:label ?author_name .
  ?author or:position ?position .
  ?author or:institution ?institution .
  ?submission or:author ?author .
  ?submission or:title ?title .
  ?submission or:num_authors ?num_authors .
  MINUS { ?author or:role [] } 
  ?author or:num_publications ?or_pubs .
  MINUS { ?author or:task_dblp_status [] }
}
GROUP BY ?submission ?num_authors
ORDER BY DESC(?num_problematic)
