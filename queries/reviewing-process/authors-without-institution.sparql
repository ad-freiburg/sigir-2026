# Authors without institution
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX or: <http://openreview.net/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?author ?label ?email (SAMPLE(?submission) AS ?sample_submission) WHERE {
  ?author rdf:type or:Author .
  ?author or:institution or:novalue .
  ?author rdfs:label ?label .
  ?author or:state ?state .
  ?author or:email ?email .
  OPTIONAL {
    ?submission or:author ?author .
    ?submission or:status "submitted" .
  }
}
GROUP BY ?author ?label ?email
